# Copy to .env for local use. On Render, add these under Environment instead.

# Contact form email delivery via Resend (https://resend.com – free tier available)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered (comma-separate for several addresses)
CONTACT_TO_EMAIL=you@example.com
# Optional. Default is onboarding@resend.dev (can only email your own Resend account address).
# After verifying your domain in Resend use e.g.:  KRISHAN WEBDESIGNERC <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# Render sets PORT automatically. Locally it defaults to 3000.
# PORT=3000
